{
  "name": "lgrp",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "seed": "node --env-file-if-exists=.env scripts/seed.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:e2e": "node --env-file-if-exists=.env test/e2e.mjs",
    "manual:pdf": "node scripts/manual-pdf.mjs",
    "check:db": "node --env-file-if-exists=.env scripts/check-db.mjs",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "admin": "node --env-file-if-exists=.env scripts/create-admin.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "framer-motion": "^12.35.0",
    "lucide-react": "^0.577.0",
    "mysql2": "^3.24.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
