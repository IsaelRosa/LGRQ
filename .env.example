# =====================================================================
# LGRP · configuração de ambiente
#
# Copie para `.env` e preencha. NUNCA versione o arquivo .env.
#
#   cp .env.example .env   (Windows: copy .env.example .env)
#
# =====================================================================

# ---------------------------------------------------------------------
# MySQL / MariaDB (hPanel -> Bancos de Dados -> phpMyAdmin)
# ---------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=lgrp
MYSQL_USER=lgrp_user
MYSQL_PASSWORD=troque-esta-senha
# Hospedagem compartilhada costuma limitar as conexões simultâneas.
# Mantenha baixo: o servidor abre um pool por processo.
MYSQL_CONNECTION_LIMIT=5
# A Hostinger não usa TLS na conexão local do MySQL.
# Só ative se o seu provedor exigir.
MYSQL_SSL=false

# ---------------------------------------------------------------------
# Sessões (OBRIGATÓRIO em produção)
# ---------------------------------------------------------------------
# Assina os tokens JWT de login. Mínimo de 32 caracteres.
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Validade da sessão: 12h, 7d, 30m...
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Endereço do frontend usado no proxy do Vite (apenas em desenvolvimento).
VITE_API_PROXY=http://localhost:3000
